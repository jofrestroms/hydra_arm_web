---
import '../../styles/global.css';
import './dashboard.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hydra | Dashboard Telemétrico</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <div id="app-container">
      <div class="sidebar">
        <div class="logo">HYDRA</div>
        <span id="doc-name-sidebar" style="color:var(--text-muted);font-size:12px;font-weight:600;">Cargando...</span>
        <nav><p onclick="window.location.href='/home/'" style="cursor:pointer;"><i class="fa-solid fa-users"></i> Pacientes</p><p class="active"><i class="fa-solid fa-chart-pie"></i> Análisis Clínico</p></nav>
        <div style="margin-top:auto;"><p onclick="window.location.href='/Login/'" style="cursor:pointer;color:var(--danger);font-weight:600;"><i class="fa-solid fa-power-off"></i> Cerrar Sesión</p></div>
      </div>
      <div class="content">
        <button class="btn-action outline" style="margin-bottom:20px;border:none;padding-left:0;" onclick="window.location.href='/home/?return=perfil'"><i class="fa-solid fa-arrow-left"></i> Volver</button>
        <header class="header-dash" style="margin-bottom:30px;"><div><h1 id="titulo-paciente">Análisis Telemétrico</h1><span id="subtitulo-rut" style="color:#64748b;font-size:14px;font-weight:500;">RUN: --------</span></div></header>
        <div class="dash-kpi-grid">
          <div class="kpi-card"><div class="kpi-icon" style="background:#e0e7ff;color:#4f46e5;"><i class="fa-solid fa-stopwatch"></i></div><div class="kpi-info"><span>Promedio Uso Diario</span><h2 id="kpi-uso">0 hrs</h2></div></div>
          <div class="kpi-card"><div class="kpi-icon" style="background:#dcfce7;color:#16a34a;"><i class="fa-solid fa-battery-half"></i></div><div class="kpi-info"><span>Eficiencia Batería</span><h2 id="kpi-bateria">0%</h2></div></div>
          <div class="kpi-card"><div class="kpi-icon" style="background:#fee2e2;color:#dc2626;"><i class="fa-solid fa-temperature-arrow-up"></i></div><div class="kpi-info"><span>Temp. Máxima Motor</span><h2 id="kpi-temp">0°C</h2></div></div>
        </div>
        <div class="charts-grid">
          <div class="chart-box"><div class="chart-title"><i class="fa-solid fa-chart-column" style="color:#4f46e5;"></i> Horas de Uso (14 días)</div><canvas id="graficoUso"></canvas></div>
          <div class="chart-box"><div class="chart-title"><i class="fa-solid fa-chart-line" style="color:#dc2626;"></i> Calor Disipado (°C)</div><canvas id="graficoTemp"></canvas></div>
        </div>
      </div>
    </div>

    <script>
      import { initDashboard } from "./_dashboard";
      initDashboard();
    </script>
  </body>
</html>
