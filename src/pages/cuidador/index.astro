---
import '../../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hydra | Panel del Cuidador</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
      .badge-notificacion { background:#ef4444;color:white;border-radius:50%;padding:2px 7px;font-size:11px;font-weight:700;margin-left:8px;box-shadow:0 2px 4px rgba(239,68,68,0.4); }
      .mensaje-card { background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:15px;margin-bottom:15px;border-left:4px solid #3b82f6; }
      .mensaje-card.critico { border-left-color:#ef4444;background:#fef2f2; }
    </style>
  </head>
  <body>
    <div id="app-container">
      <div class="sidebar">
        <div class="logo">HYDRA</div>
        <span id="caregiver-name-sidebar" style="color:var(--text-muted);font-size:12px;font-weight:600;">Cuidador: Cargando...</span>
        <nav><p class="active" onclick="window.volverAlDirectorioCuidador()" style="cursor:pointer;"><i class="fa-solid fa-house-user"></i> Panel de Asistencia</p><p><i class="fa-solid fa-clock-rotate-left"></i> Historial de Alertas</p></nav>
        <div style="margin-top:auto;"><p onclick="window.location.href='/Login/'" style="cursor:pointer;color:var(--danger);font-weight:600;"><i class="fa-solid fa-power-off"></i> Cerrar Sesión</p></div>
      </div>
      <div class="content">
        <div id="vista-principal-cuidador">
          <header class="header-dash" style="margin-bottom:30px;"><div><h1>Consola de Monitoreo Diario</h1><span style="color:var(--text-muted);font-size:13px;">Seguimiento clínico de pacientes a cargo.</span></div></header>

          <h3 style="color:var(--text-main);display:flex;align-items:center;gap:10px;font-size:18px;"><i class="fa-solid fa-comments" style="color:#2563eb;"></i> Módulo: Bitácora y Mensajería</h3>
          <div style="margin-top:15px;margin-bottom:30px;background:#fff;padding:20px;border-radius:12px;border:1px solid #e2e8f0;">
            <table class="patient-table" style="width:100%;"><thead><tr><th>RUT</th><th>Nombre</th><th>Apellido</th><th>Teléfono</th><th>Acciones</th></tr></thead><tbody id="tabla-pacientes-cuidador"><tr><td colspan="5" style="text-align:center;color:var(--text-muted);">Cargando pacientes...</td></tr></tbody></table>
          </div>

          <h3 style="color:var(--text-main);display:flex;align-items:center;gap:10px;font-size:18px;"><i class="fa-solid fa-truck-medical" style="color:#ef4444;"></i> Módulo: Central de Enlace Clínico y Alertas</h3>
          <div style="margin-top:15px;margin-bottom:30px;background:#fff;padding:25px;border-radius:12px;border:1px solid #e2e8f0;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:25px;">
              <div><div><label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">1. Seleccionar Paciente</label><select id="alerta-paciente" onchange="window.renderizarCanalAlertas()" style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;"><option value="Luis Jofré Aguirre">Luis Jofré Aguirre</option><option value="Valentina Morales Castro">Valentina Morales Castro</option><option value="Andrés Sepúlveda Rojas">Andrés Sepúlveda Rojas</option></select></div>
                <div style="margin-top:10px;"><label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">2. Tipo de Requerimiento</label><select id="alerta-tipo" style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;"><option value="Información">Información General (Baja)</option><option value="Emergencia">Alerta Médica (Media)</option><option value="Ambulancia">🚨 AMBULANCIA (Alta)</option></select></div>
                <div style="margin-top:10px;"><label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">3. Síntomas / Glosa</label><textarea id="alerta-descripcion" style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;min-height:80px;resize:vertical;box-sizing:border-box;" placeholder="Describa los síntomas..."></textarea></div>
                <div style="display:flex;justify-content:flex-end;margin-top:5px;"><button class="btn-action" style="background:#ef4444;color:white;border:none;font-weight:600;padding:12px 25px;display:flex;gap:8px;align-items:center;" onclick="window.emitirAlertaClinica()"><i class="fa-solid fa-tower-broadcast"></i> Transmitir</button></div>
              </div>
              <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:15px;"><span style="font-size:11px;font-weight:700;color:#475569;display:flex;align-items:center;gap:6px;"><i class="fa-solid fa-satellite-dish"></i> Despachos (Filtrado)</span><div id="historial-alertas-cuidador" style="flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:8px;margin-top:12px;"></div></div>
            </div>
          </div>
        </div>

        <div id="vista-bandeja-mensajes" style="display:none;">
          <button class="btn-action outline" style="margin-bottom:20px;border:none;padding-left:0;" onclick="window.volverAlDirectorioCuidador()"><i class="fa-solid fa-arrow-left"></i> Volver</button>
          <h2 id="bandeja-nombre-paciente">Cargando...</h2>
          <p id="bandeja-rut-paciente" style="color:#64748b;">---</p>
          <div id="contenedor-mensajes"></div>
        </div>

        <div id="vista-chat-paciente" style="display:none;">
          <button class="btn-action outline" style="margin-bottom:20px;border:none;padding-left:0;" onclick="window.volverAlDirectorioCuidador()"><i class="fa-solid fa-arrow-left"></i> Volver</button>
          <div style="display:flex;justify-content:space-between;align-items:center;"><h2 id="chat-nombre-paciente">Cargando...</h2><button class="btn-action" style="background:#ef4444;color:white;border:none;font-weight:700;padding:12px 20px;display:flex;gap:8px;align-items:center;" onclick="window.abrirModalAmbulancia()"><i class="fa-solid fa-truck-medical"></i> AMBULANCIA</button></div>
          <div style="background:white;border-radius:24px;padding:25px;box-shadow:var(--soft-shadow);min-height:400px;">
            <div style="padding:12px 15px;border-radius:12px;font-size:13px;max-width:70%;line-height:1.4;margin-bottom:15px;background:#f1f5f9;color:#1e293b;border-bottom-left-radius:2px;"><strong>Luis Jofré:</strong> Buenos días, siento un pequeño dolor en el muñón.</div>
            <div style="padding:12px 15px;border-radius:12px;font-size:13px;max-width:70%;line-height:1.4;margin-bottom:15px;background:#2563eb;color:white;border-bottom-right-radius:2px;align-self:flex-end;margin-left:auto;">Buenos días. ¿La intensidad es leve o moderada?</div>
            <div style="display:flex;gap:10px;margin-top:auto;padding-top:15px;"><input type="text" style="flex:1;padding:12px;border-radius:12px;border:1px solid #cbd5e1;outline:none;" placeholder="Escribe..." /><button class="btn-action" style="padding:12px 20px;"><i class="fa-solid fa-paper-plane"></i></button></div>
          </div>
        </div>
      </div>
    </div>

    <div id="modal-ambulancia" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(15,23,42,0.5);backdrop-filter:blur(8px);z-index:2000;justify-content:center;align-items:center;">
      <div style="background:white;padding:30px;border-radius:24px;width:420px;text-align:center;"><i class="fa-solid fa-truck-medical" style="font-size:60px;color:#ef4444;margin-bottom:20px;"></i><h2 style="margin:0;color:#0f172a;">Confirmar Ambulancia</h2><p style="color:#64748b;margin:15px 0;">Despachar unidad para <strong id="nombre-modal-amb">---</strong>.</p><div style="display:flex;gap:15px;justify-content:center;margin-top:25px;"><button class="btn-action outline" onclick="window.cerrarModalAmbulancia()" style="padding:12px 25px;border:1px solid #cbd5e1;">Cancelar</button><button class="btn-action" style="background:#ef4444;color:white;border:none;padding:12px 25px;" onclick="window.confirmarAmbulancia()">Confirmar</button></div></div>
    </div>

    <script>
      import { initCuidador } from "./_cuidador";
      initCuidador();
    </script>
  </body>
</html>
