---
import '../../styles/global.css';
import './protesis.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hydra | Solicitud de Prótesis</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <div id="app-container">
      <div class="sidebar">
        <div class="logo">HYDRA</div>
        <span id="doc-name-sidebar" style="color:var(--text-muted);font-size:12px;font-weight:600;">Cargando...</span>
        <nav><p onclick="window.location.href='/home/'" style="cursor:pointer;"><i class="fa-solid fa-users"></i> Pacientes</p><p><i class="fa-solid fa-heart-pulse"></i> Monitor Prótesis</p></nav>
        <div style="margin-top:auto;"><p onclick="window.location.href='/Login/'" style="cursor:pointer;color:var(--danger);font-weight:600;"><i class="fa-solid fa-power-off"></i> Cerrar Sesión</p></div>
      </div>
      <div class="content">
        <button class="btn-action outline" style="margin-bottom:20px;border:none;padding-left:0;" onclick="window.location.href='/home/?return=perfil'"><i class="fa-solid fa-arrow-left"></i> Volver</button>
        <header class="header-dash" style="margin-bottom:30px;"><div><h1>Catálogo & Solicitudes de Hardware</h1><span style="color:var(--text-muted);font-size:13px;">Gestión de requerimientos clínicos para manufactura robótica.</span></div></header>
        <div class="grid-protesis">
          <div class="card-protesis"><div class="img-protesis"><i class="fa-solid fa-hand-sparkles"></i></div><span class="tag-protesis">Transradial Avanzada</span><h3>Hydra Biónica RX-7</h3><p>Prótesis robótica con 5 grados de libertad y conexión mioeléctrica.</p><button class="btn-solicitar" onclick="window.abrirModalSolicitud('Hydra Biónica RX-7')">Solicitar</button></div>
          <div class="card-protesis"><div class="img-protesis"><i class="fa-solid fa-hand-fist"></i></div><span class="tag-protesis">Ciberware de Impacto</span><h3>Brazos de Gorila</h3><p>Reemplazo ligero para combate pesado. Incrementa fuerza física pasiva.</p><button class="btn-solicitar" onclick="window.abrirModalSolicitud('Brazos de Gorila')">Solicitar</button></div>
          <div class="card-protesis"><div class="img-protesis"><i class="fa-solid fa-gavel"></i></div><span class="tag-protesis">Ciberware de Filo</span><h3>Garras de Mantis</h3><p>Cuchillas letales ocultas en antebrazos. Ideales para ataques rápidos.</p><button class="btn-solicitar" onclick="window.abrirModalSolicitud('Garras de Mantis')">Solicitar</button></div>
          <div class="card-protesis"><div class="img-protesis"><i class="fa-solid fa-cable-car"></i></div><span class="tag-protesis">Ciberware de Red</span><h3>Monocable Técnico</h3><p>Fibra nanométrica en la muñeca. Látigo mortal de medio alcance.</p><button class="btn-solicitar" onclick="window.abrirModalSolicitud('Monocable Técnico')">Solicitar</button></div>
        </div>
      </div>
    </div>

    <div id="modal-solicitud" class="modal-overlay" style="display:none;">
      <div class="modal-content">
        <h2><i class="fa-solid fa-file-signature"></i> Nueva Solicitud</h2>
        <p>Componente: <strong id="nombre-modelo-solicitud">---</strong></p>
        <form id="form-solicitud">
          <div class="input-group"><label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">RUT del Paciente</label><input type="text" id="solicitud-rut" placeholder="Ej: 19.283.746-5" required style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;box-sizing:border-box;" /><div id="error-rut-solicitud" style="display:none;color:#ef4444;font-size:12px;margin-top:5px;">⚠️ RUT inválido.</div></div>
          <div class="input-group" style="margin-top:15px;"><label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">Justificación Médica</label><textarea id="solicitud-obs" placeholder="Describa las condiciones del muñón..." required style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;min-height:80px;resize:vertical;box-sizing:border-box;"></textarea></div>
        </form>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:25px;"><button class="btn-action outline" onclick="window.cerrarModalSolicitud()" style="padding:10px 20px;border:1px solid #cbd5e1;">Cancelar</button><button class="btn-action" style="background:#10b981;color:white;border:none;padding:10px 20px;" onclick="window.enviarSolicitud()">Enviar</button></div>
      </div>
    </div>

    <script>
      import { initProtesis } from "./_protesis";
      initProtesis();
    </script>
  </body>
</html>
