---
import '../../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hydra | Panel de Autorizaciones</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <div id="app-container">
      <div class="sidebar">
        <div class="logo">HYDRA</div>
        <span id="auth-name-sidebar" style="color: var(--text-muted); font-size: 12px; font-weight: 600;">Autorizador: Finanzas</span>
        <nav><p class="active"><i class="fa-solid fa-shield-heart"></i> Control y Visaciones</p><p><i class="fa-solid fa-building-columns"></i> Auditoría Presupuestaria</p></nav>
        <div style="margin-top: auto;"><p onclick="window.location.href='/Login/'" style="cursor:pointer; color: var(--danger); font-weight: 600;"><i class="fa-solid fa-power-off"></i> Cerrar Sesión</p></div>
      </div>
      <div class="content">
        <header class="header-dash" style="margin-bottom:30px;"><div><h1>Panel Central de Autorizaciones</h1><span style="color:var(--text-muted);font-size:13px;">Validación regulatoria de recetas emitidas, órdenes de hardware e historiales de cobertura.</span></div></header>

        <h3 style="color:var(--text-main);display:flex;align-items:center;gap:10px;font-size:18px;"><i class="fa-solid fa-file-prescription"></i> Módulo: Validación y Visación de Recetas Médicas (Bucket)</h3>
        <div style="margin-top:15px;margin-bottom:30px;background:#ffffff;padding:20px;border-radius:12px;border:1px solid #e2e8f0;">
          <table style="width:100%;border-collapse:collapse;"><thead><tr><th>Paciente</th><th>Fecha Carga</th><th>Archivo en Bucket</th><th>Detalle Medicamentos</th><th>Acciones</th></tr></thead><tbody id="lista-recetas-pendientes"><tr><td colspan="5" style="text-align:center;color:#64748b;">No hay recetas pendientes en el bucket actualmente.</td></tr></tbody></table>
        </div>

        <h3 style="color:var(--text-main);display:flex;align-items:center;gap:10px;font-size:18px;"><i class="fa-solid fa-robot" style="color:#8b5cf6;"></i> Módulo: Aprobación de Órdenes de Prótesis Biónicas</h3>
        <div style="margin-top:15px;margin-bottom:30px;background:#ffffff;padding:20px;border-radius:12px;border:1px solid #e2e8f0;">
          <table style="width:100%;border-collapse:collapse;"><thead><tr><th>RUT Destinatario</th><th>Modelo Prótesis</th><th>Justificación Clínica</th><th>Costo Manufactura</th><th>Acciones</th></tr></thead><tbody id="lista-solicitudes-pendientes"><tr><td colspan="5" style="text-align:center;color:#64748b;">No hay órdenes de prótesis pendientes.</td></tr></tbody></table>
        </div>

        <h3 style="color:var(--text-main);display:flex;align-items:center;gap:10px;font-size:18px;"><i class="fa-solid fa-building-columns" style="color:#475569;"></i> Módulo: Cobertura Financiera, Seguros y Cuentas de Pacientes</h3>
        <div style="margin-top:15px;margin-bottom:30px;background:#ffffff;padding:20px;border-radius:12px;border:1px solid #e2e8f0;">
          <div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;">
            <div style="border-right:1px solid #e2e8f0;padding-right:20px;">
              <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">Buscar Paciente (Filtro Financiero)</label>
              <select id="auth-paciente-select" onchange="window.mostrarFinanzasPaciente()" style="width:100%;padding:10px;border-radius:6px;border:1px solid #cbd5e1;outline:none;"><option value="">-- Seleccione un paciente --</option><option value="21799988-k">Luis Jofré Aguirre (21.799.988-k)</option><option value="19432105-8">Valentina Morales Castro (19.432.105-8)</option><option value="15890334-2">Andrés Sepúlveda Rojas (15.890.334-2)</option></select>
              <div style="margin-top:20px;background:#f8fafc;padding:15px;border-radius:8px;"><span style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;">Previsión / Seguro Médico</span><p id="auth-val-prev-seg" style="font-size:14px;color:#0f172a;font-weight:600;margin:8px 0;">---</p><p id="auth-val-cob" style="font-size:14px;margin:5px 0;color:#16a34a;">---</p></div>
            </div>
            <div>
              <span style="font-size:12px;font-weight:700;color:#475569;"><i class="fa-solid fa-history"></i> Historial de Transacciones y Copagos</span>
              <table style="width:100%;border-collapse:collapse;margin-top:10px;"><thead><tr><th>Fecha</th><th>Concepto</th><th>Monto Total</th><th>Copago Paciente</th><th>Estado</th></tr></thead><tbody><tr><td>12/05/2026</td><td>Calibración de Servomotores RX-7</td><td>$120.000</td><td>$24.000</td><td><span style="background:#dcfce7;color:#15803d;padding:2px 10px;border-radius:12px;font-size:11px;">Pagado</span></td></tr><tr><td>28/05/2026</td><td>Atención Médica Fisiatría</td><td>$45.000</td><td>$9.000</td><td><span style="background:#dcfce7;color:#15803d;padding:2px 10px;border-radius:12px;font-size:11px;">Pagado</span></td></tr></tbody></table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { initAutorizador } from "./_autorizador";
      initAutorizador();
    </script>
  </body>
</html>
