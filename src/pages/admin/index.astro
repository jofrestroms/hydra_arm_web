---
import '../../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hydra | Administración</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <div id="app-container">
      <div class="sidebar">
        <div class="logo">HYDRA</div>
        <span style="color: var(--warning); font-size: 12px; font-weight: bold;"><i class="fa-solid fa-shield-halved"></i> Panel Administrador</span>
        <nav>
          <p class="active" onclick="window.scrollTo(0,0)"><i class="fa-solid fa-folder-open"></i> Directorios</p>
          <p onclick="window.abrirModalAgregar('paciente')"><i class="fa-solid fa-user-plus"></i> Agregar Paciente</p>
          <p onclick="window.abrirModalAgregar('empleado')"><i class="fa-solid fa-user-tie"></i> Agregar Empleado</p>
        </nav>
        <div style="margin-top: auto;"><p onclick="window.location.href='/Login/'" style="cursor:pointer; color: var(--danger); font-weight: 600;"><i class="fa-solid fa-power-off"></i> Cerrar Sesión</p></div>
      </div>
      <div class="content">
        <header class="header-dash"><div><h1>Gestión de Directorios</h1><span style="color: var(--text-muted); font-size: 13px;">Plataforma de Control Robótico y Telemetría</span></div></header>
        <div style="display: flex; gap: 10px; margin-bottom: 20px;">
          <button class="btn-action" id="btn-tab-pacientes" onclick="window.cambiarDirectorio('pacientes')"><i class="fa-solid fa-users"></i> Directorio Pacientes</button>
          <button class="btn-action outline" id="btn-tab-empleados" onclick="window.cambiarDirectorio('empleados')"><i class="fa-solid fa-user-doctor"></i> Directorio Empleados</button>
        </div>
        <div class="table-container" id="contenedor-pacientes">
          <table class="patient-table"><thead><tr><th>RUT</th><th>Nombre</th><th>Apellido</th><th>Teléfono</th><th>Acciones</th></tr></thead><tbody id="cuerpo-tabla-pacientes"><tr><td colspan="5" style="text-align:center; color:var(--text-muted);">Cargando pacientes...</td></tr></tbody></table>
        </div>
        <div class="table-container" id="contenedor-empleados" style="display: none;">
          <table class="patient-table"><thead><tr><th>RUT</th><th>Nombre</th><th>Apellido</th><th>Rol</th><th>Acciones</th></tr></thead><tbody id="cuerpo-tabla-empleados"><tr><td colspan="5" style="text-align:center; color:var(--text-muted);">Cargando empleados...</td></tr></tbody></table>
        </div>
      </div>
    </div>

    <script>
      import { initAdmin } from "./_admin";
      initAdmin();
    </script>
  </body>
</html>
